__pycache__/
*.pyc
*.pyo
*.tmp
.DS_Store
Thumbs.db

# Raw HTTP cache - re-fetchable, never committed
.cache/

# Social scout: browser profile holds login cookies; cache holds thumbnails
scout/browser-profile/
scout/cache/

# Local secrets (College Scorecard API key etc.)
.env

# Agents' and reviewers' scratch notes (issue #195). Scratch belongs in the session scratchpad outside the
# repository; a scratchpad/ folder inside a worktree is ignored so notes are never swept into a commit or
# into the working-tree scans some tests run (tests/rpi_attribution_test.py). tests/scratchpad_ignored_test.py
# fails if anything under scratchpad/ is tracked anyway (git add -f).
scratchpad/

# Cloudflare wrangler scratch and any npx download
.wrangler/
node_modules/

# programs/, data/ and public/ ARE committed - they are the durable database.
