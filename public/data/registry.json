        "2018": "1fmcljR-2zyD8-Sdw0EE7WqlWB-p5zLXV",
        "2017": "1N_drOt-14-KXK_fpM6JcjBrpiaUFW16t",
        "2016": "1WmWsaM5FpGsY04XlliL1p_VmK6dkzIZ9",
        "2015": "1MIy6dLnzLAvrqQfXJpPNWl2jdR5wZBdS",
        "2014": "1VZgFdwNMfWjSzjLYDT63UbvD1wkXcksr",
        "2013": "1ja1SyDbAeHpga0phYD3FxH7dZoO60SPp",
        "2012": "1A1zlGyK_2H1UAzgNRBSEPseyJ7A6de_7",
        "2011": "1gWN6FJT2zzQlKr0RrMdz2uLyr3G4ddpy",
        "2010": "1Fxn8vLajqdEMQ8jZkH6frvqDfffCg4zX",
        "2009": "1lGvenBpYd-Lc5dY68t2WZa7EPOT3y_1Y",
        "2008": "1jTfqPJyj3HMlW2PSa09V0BvS6yaHPVvo",
        "2007": "17h7yUY2ObNClWgW9GkX_WWuVV1lf6n-A"
      }
    },
    "scorecard": {
      "_comment": "US Dept. of Education College Scorecard. Free API key from https://api.data.gov/signup/ ; export SCORECARD_API_KEY. Falls back to DEMO_KEY (30 req/hour) when unset.",
      "api": "https://api.data.gov/ed/collegescorecard/v1/schools",
      "keyEnv": "SCORECARD_API_KEY"
    },
    "climate": {
      "_comment": "Open-Meteo Historical Weather API (ERA5 reanalysis), no key. Daily data aggregated to 1991-2020 monthly normals.",
      "api": "https://archive-api.open-meteo.com/v1/archive",
      "normalsStart": 1991,
      "normalsEnd": 2020
    },
    "wikipedia": {
      "htmlApi": "https://en.wikipedia.org/api/rest_v1/page/html/{title}"
    },
    "athleticsPlatforms": {
      "_comment": "Adapter per site platform. wmt = WMT Digital (Stanford, UCLA): /roster, /roster/season/{year}, /roster/player/{slug}, /schedule/season/{year}, /news. sidearm = Sidearm Sports (USC, Duke, most D1): /roster, /roster/{year}, /roster/{slug}/{id}, /schedule/{year}, news via /rss?path=wsoc plus /archives.",
      "wmt": {
        "roster": "{baseUrl}{sportPath}/roster",
        "rosterSeason": "{baseUrl}{sportPath}/roster/season/{year}",
        "schedule": "{baseUrl}{sportPath}/schedule",
        "scheduleSeason": "{baseUrl}{sportPath}/schedule/season/{year}",
        "news": "{baseUrl}{sportPath}/news"
      },
      "sidearm": {
        "roster": "{baseUrl}{sportPath}/roster",
        "rosterSeason": "{baseUrl}{sportPath}/roster/{year}",
        "schedule": "{baseUrl}{sportPath}/schedule",
        "scheduleSeason": "{baseUrl}{sportPath}/schedule/{year}",
        "news": "{baseUrl}{sportPath}/archives",
        "rss": "{baseUrl}/rss?path=wsoc"
      }
    }
  },
