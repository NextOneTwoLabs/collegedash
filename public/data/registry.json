{
  "_comment": "Program registry for CollegeDash. Single source of truth for which programs exist, where their data comes from (athletics site platform, TopDrawerSoccer ids, College Scorecard unit id, Wikipedia title, social handles) and the URL templates every collector uses. Read by collect/*, build.py and public/index.html. Add a program by appending to `programs` and running: python collegedash.py onboard <slug>",
  "updated": "2026-09-05",
  "division": "D1",
  "season": {
    "_comment": "current = the fall season being played; gradYears = high-school classes tracked for commitments",
    "current": 2026,
    "gradYears": [2026, 2027, 2028, 2029]
  },
  "sources": {
    "tds": {
      "_comment": "TopDrawerSoccer. Team commitments tab is public HTML (no dates). The commitments search lists every girls commit per class, 25 per page, paginated with pageNo (0-based).",
      "team": "https://www.topdrawersoccer.com/college-soccer/college-soccer-details/women/{tdsSlug}/clgid-{tdsClgId}",
      "teamCommitments": "https://www.topdrawersoccer.com/college-soccer/college-soccer-details/women/{tdsSlug}/clgid-{tdsClgId}/tab-commitments",
      "commitSearch": "https://www.topdrawersoccer.com/search/?query=&divisionId=&genderId=f&graduationYear={gradYear}&positionId=0&playerRating=&stateId=All&pageNo={page}&area=commitments",
      "pageSize": 25
    },
    "soccerwire": {
      "_comment": "SoccerWire player directory is backed by an Elasticsearch proxy; the page's ?filter= param is base64 JSON with facet keys meta.gender.raw, meta.graduation_year.raw, meta.is_committed.raw, meta.college_team.raw.",
      "elasticProxy": "https://www.soccerwire.com/wp-json/v1/elastic-proxy/soccerwirecom-post-1/_search",
      "directory": "https://www.soccerwire.com/soccer-player-directory/",
      "pageSize": 21
    },
    "ncaaRpi": {
      "_comment": "Server-rendered table (class 'sticky') with 'Through Games <date>' in figure.rankings-last-updated. Only the latest week is published, so each weekly snapshot is archived under public/data/rpi/weekly/.",
      "current": "https://www.ncaa.com/rankings/soccer-women/d1/ncaa-womens-soccer-rpi"
    },
    "rpiHistory": {
      "_comment": "End-of-season RPI reports 2007-2024 (no 2020) by Chris Henderson, 'RPI for Division I Women's Soccer'. Google Sheets, Teams tab exported as CSV. Ranks are recomputed under the 2024 NCAA formula, so pre-2024 values differ slightly from what the NCAA published at the time.",
      "page": "https://sites.google.com/site/rpifordivisioniwomenssoccer/reports-archive",
      "xlsxTemplate": "https://docs.google.com/spreadsheets/d/{sheetId}/export?format=xlsx",
      "csvTemplate": "https://docs.google.com/spreadsheets/d/{sheetId}/gviz/tq?tqx=out:csv&sheet=Teams",
      "sheets": {
        "2024": "1Yr-6iSZnhojbe0CgSgMtqVWL_w-bLl8I",
        "2023": "1RX-3HkLGZVaf3ptiY5YxytIJZ8nV09Wl",
